package pages

import (
	"github.com/omegaatt36/bookly/app/web/templates/layout"
	api "github.com/omegaatt36/bookly/app/web/api"
)

templ RecurringTransactions(user *api.User, transactions []api.RecurringTransaction) {
	@layout.Base("定期交易", user) {
		<div class="max-w-7xl mx-auto">
			<!-- Header Section -->
			<div class="flex items-center justify-between mb-8">
				<div>
					<h1 class="text-2xl font-bold text-foreground mb-2">定期交易</h1>
					<p class="text-muted-foreground">管理您的定期收入與支出</p>
				</div>
				<button
					class="px-4 py-2 bg-primary text-primary-foreground rounded-lg hover:bg-primary/90 transition-colors flex items-center"
					hx-get="/recurring/new"
					hx-target="#modal-container"
					hx-swap="innerHTML"
				>
					<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
					</svg>
					新增定期交易
				</button>
			</div>

			<!-- Filter Tabs -->
			<div class="bg-background-secondary border border-border rounded-lg p-1 mb-6 inline-flex">
				<button
					class="px-4 py-2 text-sm font-medium rounded-md transition-colors bg-primary text-primary-foreground"
					hx-get="/recurring?status=all"
					hx-target="#recurring-list"
					hx-swap="outerHTML"
				>
					全部
				</button>
				<button
					class="px-4 py-2 text-sm font-medium rounded-md transition-colors text-foreground hover:bg-background-tertiary"
					hx-get="/recurring?status=active"
					hx-target="#recurring-list"
					hx-swap="outerHTML"
				>
					啟用中
				</button>
				<button
					class="px-4 py-2 text-sm font-medium rounded-md transition-colors text-foreground hover:bg-background-tertiary"
					hx-get="/recurring?status=paused"
					hx-target="#recurring-list"
					hx-swap="outerHTML"
				>
					已暫停
				</button>
				<button
					class="px-4 py-2 text-sm font-medium rounded-md transition-colors text-foreground hover:bg-background-tertiary"
					hx-get="/recurring?status=completed"
					hx-target="#recurring-list"
					hx-swap="outerHTML"
				>
					已完成
				</button>
			</div>

			<!-- Recurring Transactions List -->
			<div id="recurring-list">
				if len(transactions) > 0 {
					<div class="space-y-4">
						for _, transaction := range transactions {
							@RecurringTransactionCard(transaction)
						}
					</div>
				} else {
					@EmptyRecurringState()
				}
			</div>
		</div>

		<!-- Modal Container -->
		<div id="modal-container"></div>
	}
}

templ RecurringTransactionCard(transaction api.RecurringTransaction) {
	<div class="bg-background-secondary border border-border rounded-lg p-6">
		<div class="flex items-start justify-between">
			<div class="flex items-start flex-1">
				<!-- Transaction Type Icon -->
				<div class="w-12 h-12 rounded-lg flex items-center justify-center mr-4"
					class={ getRecurringIconBg(transaction.Type) }>
					if transaction.Type == "income" {
						<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
						</svg>
					} else if transaction.Type == "expense" {
						<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
						</svg>
					} else {
						<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
						</svg>
					}
				</div>

				<!-- Transaction Details -->
				<div class="flex-1">
					<div class="flex items-start justify-between mb-2">
						<div>
							<h3 class="font-semibold text-foreground text-lg">{ transaction.Note }</h3>
							<p class="text-sm text-muted-foreground">
								{ getAccountName(transaction.AccountID) }
								if transaction.Note != "" {
									- { transaction.Note }
								}
							</p>
						</div>
						<div class="text-right">
							<div class="text-xl font-bold"
								class={ getRecurringAmountColor(transaction.Type) }>
								{ formatRecurringAmount(transaction.Type, transaction.Amount) }
							</div>
						</div>
					</div>

					<!-- Schedule Info -->
					<div class="flex items-center space-x-6 mb-4">
						<div class="flex items-center">
							<svg class="w-4 h-4 text-muted-foreground mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
							</svg>
							<span class="text-sm text-muted-foreground">
								{ getFrequencyText(transaction.RecurrenceType) }
							</span>
						</div>
						<div class="flex items-center">
							<svg class="w-4 h-4 text-muted-foreground mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
							</svg>
							<span class="text-sm text-muted-foreground">
								下次執行：{ transaction.NextDue.Format("2006-01-02") }
							</span>
						</div>
						if transaction.LastExecuted != nil {
							<div class="flex items-center">
								<svg class="w-4 h-4 text-muted-foreground mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
								</svg>
								<span class="text-sm text-muted-foreground">
									上次執行：{ transaction.LastExecuted.Format("2006-01-02") }
								</span>
							</div>
						}
					</div>

					<!-- Status and Actions -->
					<div class="flex items-center justify-between">
						<div class="flex items-center space-x-3">
							<span class="px-3 py-1 text-xs rounded-full"
								class={ getRecurringStatusBg(transaction.Status) }>
								{ getRecurringStatusText(transaction.Status) }
							</span>
							if transaction.EndDate != nil {
								<span class="text-xs text-muted-foreground">
									結束日期：{ transaction.EndDate.Format("2006-01-02") }
								</span>
							}
						</div>

						<div class="flex items-center space-x-2">
							<button
								class="px-3 py-1 text-xs bg-primary/20 text-primary rounded hover:bg-primary/30 transition-colors"
								hx-get={ "/recurring/" + string(rune(transaction.ID)) + "/edit" }
								hx-target="#modal-container"
								hx-swap="innerHTML"
							>
								編輯
							</button>
							if transaction.Status == "active" {
								<button
									class="px-3 py-1 text-xs bg-warning/20 text-warning rounded hover:bg-warning/30 transition-colors"
									hx-post={ "/recurring/" + string(rune(transaction.ID)) + "/pause" }
									hx-target="#recurring-list"
									hx-swap="outerHTML"
								>
									暫停
								</button>
							} else if transaction.Status == "paused" {
								<button
									class="px-3 py-1 text-xs bg-success/20 text-success rounded hover:bg-success/30 transition-colors"
									hx-post={ "/recurring/" + string(rune(transaction.ID)) + "/resume" }
									hx-target="#recurring-list"
									hx-swap="outerHTML"
								>
									恢復
								</button>
							}
							<button
								class="px-3 py-1 text-xs bg-destructive/20 text-destructive rounded hover:bg-destructive/30 transition-colors"
								hx-delete={ "/recurring/" + string(rune(transaction.ID)) }
								hx-target="#recurring-list"
								hx-swap="outerHTML"
								hx-confirm="確定要刪除此定期交易嗎？"
							>
								刪除
							</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}

templ EmptyRecurringState() {
	<div class="text-center py-12">
		<svg class="w-24 h-24 text-muted-foreground mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
		</svg>
		<h3 class="text-lg font-semibold text-foreground mb-2">尚未設定定期交易</h3>
		<p class="text-muted-foreground mb-6">建立定期交易來自動化您的財務管理</p>
		<button
			class="px-6 py-3 bg-primary text-primary-foreground rounded-lg hover:bg-primary/90 transition-colors"
			hx-get="/recurring/new"
			hx-target="#modal-container"
			hx-swap="innerHTML"
		>
			建立第一個定期交易
		</button>
	</div>
}

func getRecurringIconBg(tType string) string {
	switch tType {
	case "income":
		return "bg-success"
	case "expense":
		return "bg-destructive"
	case "transfer":
		return "bg-primary"
	default:
		return "bg-muted"
	}
}

func getRecurringAmountColor(tType string) string {
	switch tType {
	case "income":
		return "text-success"
	case "expense":
		return "text-destructive"
	case "transfer":
		return "text-primary"
	default:
		return "text-foreground"
	}
}

func formatRecurringAmount(tType, amount string) string {
	switch tType {
	case "income":
		return "+" + amount
	case "expense":
		return "-" + amount
	case "transfer":
		return amount
	default:
		return amount
	}
}

func getRecurringStatusBg(status string) string {
	switch status {
	case "active":
		return "bg-success/20 text-success"
	case "paused":
		return "bg-warning/20 text-warning"
	case "completed":
		return "bg-muted/20 text-muted-foreground"
	case "cancelled":
		return "bg-destructive/20 text-destructive"
	default:
		return "bg-muted/20 text-muted-foreground"
	}
}

func getRecurringStatusText(status string) string {
	switch status {
	case "active":
		return "啟用中"
	case "paused":
		return "已暫停"
	case "completed":
		return "已完成"
	case "cancelled":
		return "已取消"
	default:
		return "未知"
	}
}

func getFrequencyText(recurType string) string {
	switch recurType {
	case "daily":
		return "每日"
	case "weekly":
		return "每週"
	case "biweekly":
		return "雙週"
	case "monthly":
		return "每月"
	case "quarterly":
		return "每季"
	case "yearly":
		return "每年"
	default:
		return "未知"
	}
}

// 注意：getAccountName 可根據實際帳戶資料來源調整
func getAccountName(accountID int32) string {
	return "帳戶 " + string(rune(accountID))
}
