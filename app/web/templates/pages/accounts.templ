package pages

import (
	"fmt"
	"github.com/omegaatt36/bookly/app/web/components/badge"
	"github.com/omegaatt36/bookly/app/web/components/button"
	"github.com/omegaatt36/bookly/app/web/components/card"
	"github.com/omegaatt36/bookly/app/web/templates/layout"
	"github.com/omegaatt36/bookly/sdk/datatype"
)

templ AccountsList(user *datatype.User, accounts []datatype.Account) {
	@layout.Base("Account Management", user) {
		<div class="max-w-7xl mx-auto">
			<!-- Header Section -->
			<div class="flex items-center justify-between mb-8">
				<div>
					<h1 class="text-2xl font-bold text-foreground mb-2">Account Management</h1>
					<p class="text-muted-foreground">Manage all your financial accounts</p>
				</div>
				@button.Button(button.Props{
					Variant:  button.VariantDefault,
					HxGet:    "/accounts/new",
					HxTarget: "#modal-container",
					HxSwap:   "innerHTML",
				}) {
					<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
					</svg>
					New Account
				}
			</div>
			<!-- Accounts Grid -->
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="accounts-list">
				for _, account := range accounts {
					@AccountCard(account)
				}
				if len(accounts) == 0 {
					<div class="col-span-full">
						@EmptyAccountsState()
					</div>
				}
			</div>
		</div>
		<!-- Modal Container -->
		<div id="modal-container"></div>
	}
}

templ AccountCard(account datatype.Account) {
	@card.Card(card.Props{
		Class: "hover:bg-background-tertiary transition-colors",
	}) {
		@card.Content() {
			<div class="flex items-start justify-between mb-4">
				<div class="flex items-center">
					<div
						class="w-12 h-12 rounded-lg flex items-center justify-center mr-3"
						class={ getAccountIconBg(account.Currency) }
					>
						<span class="text-lg font-bold text-white">
							{ getCurrencySymbol(account.Currency) }
						</span>
					</div>
					<div>
						<h3 class="font-semibold text-foreground">{ account.Name }</h3>
						<p class="text-sm text-muted-foreground">{ account.Currency }</p>
					</div>
				</div>
				<div class="flex items-center space-x-2">
					if account.Status == "active" {
						@badge.Badge(badge.Props{
							Variant: badge.VariantDefault,
							Class:   "bg-success text-success-foreground border-transparent",
						}) {
							Active
						}
					} else {
						@badge.Badge(badge.Props{
							Variant: badge.VariantSecondary,
						}) {
							Disabled
						}
					}
					<div class="relative">
						@button.Button(button.Props{
							Variant:    button.VariantGhost,
							Size:       button.SizeIcon,
							Class:      "p-1 w-8 h-8",
							Attributes: templ.Attributes{"onclick": "toggleDropdown()"},
						}) {
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01"></path>
							</svg>
						}
						<div class="absolute right-0 mt-2 w-48 bg-background-secondary border border-border rounded-lg shadow-lg hidden z-10">
							@button.Button(button.Props{
								Variant: button.VariantGhost,
								Href:    fmt.Sprintf("/accounts/%d", account.ID),
								Class:   "w-full justify-start px-4 py-2 text-sm",
							}) {
								View Details
							}
							@button.Button(button.Props{
								Variant:  button.VariantGhost,
								HxGet:    fmt.Sprintf("/accounts/%d/edit", account.ID),
								HxTarget: "#modal-container",
								HxSwap:   "innerHTML",
								Class:    "w-full justify-start px-4 py-2 text-sm",
							}) {
								Edit
							}
							if account.Status == "active" {
								@button.Button(button.Props{
									Variant:    button.VariantGhost,
									HxPost:     fmt.Sprintf("/accounts/%d/deactivate", account.ID),
									HxTarget:   "#accounts-list",
									HxSwap:     "outerHTML",
									Class:      "w-full justify-start px-4 py-2 text-sm text-warning",
									Attributes: templ.Attributes{"hx-confirm": "Are you sure you want to disable this account?"},
								}) {
									Disable Account
								}
							} else {
								@button.Button(button.Props{
									Variant:  button.VariantGhost,
									HxPost:   fmt.Sprintf("/accounts/%d/activate", account.ID),
									HxTarget: "#accounts-list",
									HxSwap:   "outerHTML",
									Class:    "w-full justify-start px-4 py-2 text-sm text-success",
								}) {
									Enable Account
								}
							}
						</div>
					</div>
				</div>
			</div>
			<!-- Balance -->
			<div class="mb-4">
				<div class="text-2xl font-bold text-foreground">
					{ account.Balance }
				</div>
				<div class="text-sm text-muted-foreground">Current Balance</div>
			</div>
			<!-- Quick Actions -->
			<div class="flex space-x-2">
				@button.Button(button.Props{
					Variant:   button.VariantOutline,
					FullWidth: true,
					Class:     "bg-success/20 text-success hover:bg-success/30 border-success/30",
					HxGet:     fmt.Sprintf("/ledgers/new?account_id=%d&type=income", account.ID),
					HxTarget:  "#modal-container",
					HxSwap:    "innerHTML",
				}) {
					Income
				}
				@button.Button(button.Props{
					Variant:   button.VariantOutline,
					FullWidth: true,
					Class:     "bg-destructive/20 text-destructive hover:bg-destructive/30 border-destructive/30",
					HxGet:     fmt.Sprintf("/ledgers/new?account_id=%d&type=expense", account.ID),
					HxTarget:  "#modal-container",
					HxSwap:    "innerHTML",
				}) {
					Expense
				}
				@button.Button(button.Props{
					Variant:   button.VariantOutline,
					FullWidth: true,
					Class:     "bg-primary/20 text-primary hover:bg-primary/30 border-primary/30",
					HxGet:     fmt.Sprintf("/ledgers/new?account_id=%d&type=transfer", account.ID),
					HxTarget:  "#modal-container",
					HxSwap:    "innerHTML",
				}) {
					Transfer
				}
			</div>
		}
		@card.Footer() {
			@button.Button(button.Props{
				Variant: button.VariantLink,
				Href:    fmt.Sprintf("/accounts/%d/ledgers", account.ID),
				Class:   "text-sm font-medium p-0",
			}) {
				View Transactions
				<svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
				</svg>
			}
		}
	}
}

templ EmptyAccountsState() {
	<div class="text-center py-12">
		<svg class="w-24 h-24 text-muted-foreground mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
		</svg>
		<h3 class="text-lg font-semibold text-foreground mb-2">No accounts created yet</h3>
		<p class="text-muted-foreground mb-6">Start by creating your first account to manage your finances</p>
		@button.Button(button.Props{
			Variant:  button.VariantDefault,
			Class:    "px-6 py-3",
			HxGet:    "/accounts/new",
			HxTarget: "#modal-container",
			HxSwap:   "innerHTML",
		}) {
			Create First Account
		}
	</div>
}

script toggleDropdown() {
	const button = this;
	const dropdown = button.nextElementSibling;
	const isHidden = dropdown.classList.contains('hidden');

	// Close all other dropdowns
	document.querySelectorAll('.absolute.right-0.mt-2').forEach(d => {
		if (d !== dropdown) d.classList.add('hidden');
	});

	// Toggle current dropdown
	dropdown.classList.toggle('hidden', !isHidden);

	// Close on outside click
	if (isHidden) {
		document.addEventListener('click', function closeDropdown(e) {
			if (!button.contains(e.target) && !dropdown.contains(e.target)) {
				dropdown.classList.add('hidden');
				document.removeEventListener('click', closeDropdown);
			}
		});
	}
}
