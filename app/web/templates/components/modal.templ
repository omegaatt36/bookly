package components

import (
	"fmt"
	"github.com/omegaatt36/bookly/app/web/components/button"
	"github.com/omegaatt36/bookly/app/web/components/input"
	"github.com/omegaatt36/bookly/app/web/components/modal"
	"github.com/omegaatt36/bookly/app/web/components/radio"
	"github.com/omegaatt36/bookly/app/web/components/selectbox"
	"github.com/omegaatt36/bookly/app/web/components/textarea"
	"github.com/omegaatt36/bookly/sdk/datatype"
)

templ Modal(title string, size string) {
	@modal.Modal() {
		@modal.Header() {
			{ title }
			@modal.Close(modal.CloseProps{
				Class: "absolute right-4 top-4 rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 disabled:pointer-events-none",
			}) {
				<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			}
		}
		@modal.Body() {
			{ children... }
		}
	}
}

templ AccountForm(account *datatype.Account, currencies []string) {
	@Modal("New Account", "md") {
		<form hx-post="/accounts" hx-target="#modal-container" hx-swap="innerHTML">
			<div class="space-y-4">
				<div>
					<label class="block text-sm font-medium text-foreground mb-1">Account Name</label>
					@input.Input(input.Props{
						Type:        input.TypeText,
						Name:        "name",
						Value:       getAccountName(account),
						Placeholder: "e.g. Bank Savings",
						Required:    true,
					})
				</div>
				<div>
					<label class="block text-sm font-medium text-foreground mb-1">Currency</label>
					@selectbox.SelectBox() {
						@selectbox.Trigger(selectbox.TriggerProps{
							Name:     "currency",
							Required: true,
						}) {
							@selectbox.Value(selectbox.ValueProps{
								Placeholder: "Select Currency",
							})
						}
						@selectbox.Content() {
							for _, currency := range currencies {
								@selectbox.Item(selectbox.ItemProps{
									Value:    currency,
									Selected: isSelectedCurrency(account, currency),
								}) {
									{ currency }
								}
							}
						}
					}
				</div>
				<div>
					<label class="block text-sm font-medium text-foreground mb-1">Initial Balance</label>
					@input.Input(input.Props{
						Type:        input.TypeNumber,
						Name:        "initial_balance",
						Value:       getAccountBalance(account),
						Placeholder: "0.00",
					})
				</div>
			</div>
			@modal.Footer() {
				<div class="flex justify-end space-x-3">
					@modal.Close() {
						@button.Button(button.Props{
							Type:    button.TypeButton,
							Variant: button.VariantOutline,
						}) {
							Cancel
						}
					}
					@button.Button(button.Props{
						Type:    button.TypeSubmit,
						Variant: button.VariantDefault,
					}) {
						{ getAccountFormButtonText(account) }
					}
				</div>
			}
		</form>
	}
}

templ LedgerForm(accounts []datatype.Account, ledgerType string, accountID int32) {
	@Modal("New Transaction", "md") {
		<form hx-post="/ledgers" hx-target="#modal-container" hx-swap="innerHTML">
			<div class="space-y-4">
				<div>
					<label class="block text-sm font-medium text-foreground mb-3">Transaction Type</label>
					<div class="grid grid-cols-3 gap-2">
						<label class="flex items-center p-3 border border-border rounded-lg cursor-pointer hover:bg-background-tertiary">
							@radio.Radio(radio.Props{
								Name:    "type",
								Value:   "income",
								Checked: isLedgerTypeSelected("income", ledgerType),
							})
							<span class="ml-2 text-sm">Income</span>
						</label>
						<label class="flex items-center p-3 border border-border rounded-lg cursor-pointer hover:bg-background-tertiary">
							@radio.Radio(radio.Props{
								Name:    "type",
								Value:   "expense",
								Checked: isLedgerTypeSelected("expense", ledgerType),
							})
							<span class="ml-2 text-sm">Expense</span>
						</label>
						<label class="flex items-center p-3 border border-border rounded-lg cursor-pointer hover:bg-background-tertiary">
							@radio.Radio(radio.Props{
								Name:    "type",
								Value:   "transfer",
								Checked: isLedgerTypeSelected("transfer", ledgerType),
							})
							<span class="ml-2 text-sm">Transfer</span>
						</label>
					</div>
				</div>
				<div>
					<label class="block text-sm font-medium text-foreground mb-1">Account</label>
					@selectbox.SelectBox() {
						@selectbox.Trigger(selectbox.TriggerProps{
							Name:     "account_id",
							Required: true,
						}) {
							@selectbox.Value(selectbox.ValueProps{
								Placeholder: "Select Account",
							})
						}
						@selectbox.Content() {
							for _, account := range accounts {
								@selectbox.Item(selectbox.ItemProps{
									Value:    fmt.Sprintf("%d", account.ID),
									Selected: isAccountSelected(account.ID, accountID),
								}) {
									{ account.Name } ({ account.Currency })
								}
							}
						}
					}
				</div>
				<div>
					<label class="block text-sm font-medium text-foreground mb-1">Amount</label>
					@input.Input(input.Props{
						Type:        input.TypeNumber,
						Name:        "amount",
						Placeholder: "0.00",
						Required:    true,
					})
				</div>
				<div>
					<label class="block text-sm font-medium text-foreground mb-1">Description</label>
					@input.Input(input.Props{
						Type:        input.TypeText,
						Name:        "description",
						Placeholder: "Transaction Description",
						Required:    true,
					})
				</div>
				<div>
					<label class="block text-sm font-medium text-foreground mb-1">Note</label>
					@textarea.Textarea(textarea.Props{
						Name:        "note",
						Placeholder: "Optional",
						Rows:        3,
					})
				</div>
				<div>
					<label class="block text-sm font-medium text-foreground mb-1">Transaction Date</label>
					@input.Input(input.Props{
						Type:     input.TypeDate,
						Name:     "transaction_date",
						Value:    getCurrentDateTime(),
						Required: true,
					})
				</div>
			</div>
			@modal.Footer() {
				<div class="flex justify-end space-x-3">
					@modal.Close() {
						@button.Button(button.Props{
							Type:    button.TypeButton,
							Variant: button.VariantOutline,
						}) {
							Cancel
						}
					}
					@button.Button(button.Props{
						Type:    button.TypeSubmit,
						Variant: button.VariantDefault,
					}) {
						Add Transaction
					}
				</div>
			}
		</form>
	}
}

templ RecurringForm(accounts []datatype.Account, frequencies []string) {
	@Modal("New Recurring Transaction", "lg") {
		<form hx-post="/recurring" hx-target="#modal-container" hx-swap="innerHTML">
			<div class="space-y-4">
				<div class="grid grid-cols-2 gap-4">
					<div>
						<label class="block text-sm font-medium text-foreground mb-1">Transaction Type</label>
						@selectbox.SelectBox() {
							@selectbox.Trigger(selectbox.TriggerProps{
								Name:     "type",
								Required: true,
							}) {
								@selectbox.Value(selectbox.ValueProps{
									Placeholder: "Select Type",
								})
							}
							@selectbox.Content() {
								@selectbox.Item(selectbox.ItemProps{Value: "income"}) {
									Income
								}
								@selectbox.Item(selectbox.ItemProps{Value: "expense"}) {
									Expense
								}
								@selectbox.Item(selectbox.ItemProps{Value: "transfer"}) {
									Transfer
								}
							}
						}
					</div>
					<div>
						<label class="block text-sm font-medium text-foreground mb-1">Account</label>
						@selectbox.SelectBox() {
							@selectbox.Trigger(selectbox.TriggerProps{
								Name:     "account_id",
								Required: true,
							}) {
								@selectbox.Value(selectbox.ValueProps{
									Placeholder: "Select Account",
								})
							}
							@selectbox.Content() {
								for _, account := range accounts {
									@selectbox.Item(selectbox.ItemProps{
										Value: fmt.Sprintf("%d", account.ID),
									}) {
										{ account.Name } ({ account.Currency })
									}
								}
							}
						}
					</div>
				</div>
				<div>
					<label class="block text-sm font-medium text-foreground mb-1">Description</label>
					@input.Input(input.Props{
						Type:        input.TypeText,
						Name:        "description",
						Placeholder: "e.g. Rent, Salary, etc.",
						Required:    true,
					})
				</div>
				<div class="grid grid-cols-2 gap-4">
					<div>
						<label class="block text-sm font-medium text-foreground mb-1">Amount</label>
						@input.Input(input.Props{
							Type:        input.TypeNumber,
							Name:        "amount",
							Placeholder: "0.00",
							Required:    true,
						})
					</div>
					<div>
						<label class="block text-sm font-medium text-foreground mb-1">Currency</label>
						@input.Input(input.Props{
							Type:        input.TypeText,
							Name:        "currency",
							Placeholder: "USD",
							Required:    true,
						})
					</div>
				</div>
				<div class="grid grid-cols-2 gap-4">
					<div>
						<label class="block text-sm font-medium text-foreground mb-1">Frequency</label>
						@selectbox.SelectBox() {
							@selectbox.Trigger(selectbox.TriggerProps{
								Name:     "frequency",
								Required: true,
							}) {
								@selectbox.Value(selectbox.ValueProps{
									Placeholder: "Select Frequency",
								})
							}
							@selectbox.Content() {
								for _, freq := range frequencies {
									@selectbox.Item(selectbox.ItemProps{
										Value: freq,
									}) {
										{ getFrequencyDisplayName(freq) }
									}
								}
							}
						}
					</div>
					<div>
						<label class="block text-sm font-medium text-foreground mb-1">Start Date</label>
						@input.Input(input.Props{
							Type:     input.TypeDate,
							Name:     "start_date",
							Value:    getCurrentDate(),
							Required: true,
						})
					</div>
				</div>
				<div>
					<label class="block text-sm font-medium text-foreground mb-1">End Date (Optional)</label>
					@input.Input(input.Props{
						Type: input.TypeDate,
						Name: "end_date",
					})
				</div>
				<div>
					<label class="block text-sm font-medium text-foreground mb-1">Note</label>
					@textarea.Textarea(textarea.Props{
						Name:        "note",
						Placeholder: "Optional",
						Rows:        3,
					})
				</div>
			</div>
			@modal.Footer() {
				<div class="flex justify-end space-x-3">
					@modal.Close() {
						@button.Button(button.Props{
							Type:    button.TypeButton,
							Variant: button.VariantOutline,
						}) {
							Cancel
						}
					}
					@button.Button(button.Props{
						Type:    button.TypeSubmit,
						Variant: button.VariantDefault,
					}) {
						Create Recurring Transaction
					}
				</div>
			}
		</form>
	}
}

func getAccountName(account *datatype.Account) string {
	if account != nil {
		return account.Name
	}
	return ""
}

func getAccountBalance(account *datatype.Account) string {
	if account != nil {
		return account.Balance
	}
	return "0"
}

func getAccountFormButtonText(account *datatype.Account) string {
	if account != nil {
		return "Update Account"
	}
	return "Create Account"
}

func isSelectedCurrency(account *datatype.Account, currency string) bool {
	return account != nil && account.Currency == currency
}

func isLedgerTypeSelected(targetType, currentType string) bool {
	if targetType == "income" {
		return currentType == "income" || currentType == ""
	}
	return currentType == targetType
}

func isAccountSelected(accountID, targetID int32) bool {
	return targetID != 0 && accountID == targetID
}

func getCurrentDateTime() string {
	return "2024-01-01T12:00"
}

func getCurrentDate() string {
	return "2024-01-01"
}

func getFrequencyDisplayName(freq string) string {
	switch freq {
	case "daily":
		return "Daily"
	case "weekly":
		return "Weekly"
	case "biweekly":
		return "Biweekly"
	case "monthly":
		return "Monthly"
	case "quarterly":
		return "Quarterly"
	case "yearly":
		return "Yearly"
	default:
		return freq
	}
}
